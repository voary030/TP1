{
	"info": {
		"_postman_id": "12345678-1234-1234-1234-123456789abc",
		"name": "TP1 - Notes API",
		"description": "Collection pour tester l'API de gestion des notes étudiantes.\n\n## Utilisation:\n1. Exécuter d'abord \"Login\" pour obtenir le token\n2. Le token est automatiquement sauvegardé dans l'environnement\n3. Tester les autres endpoints\n\n## Format de réponse:\n- `status`: \"success\" ou \"error\"\n- `data`: données de réponse (en cas de succès)\n- `error`: détails de l'erreur (en cas d'erreur)\n- `meta`: métadonnées (timestamp, version)",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login - Jean (Développeur)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"// Sauvegarder le token automatiquement",
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    if (jsonData.status === 'success' && jsonData.data.token) {",
									"        pm.environment.set('authToken', jsonData.data.token);",
									"        console.log('Token saved:', jsonData.data.token);",
									"    }",
									"}",
									"",
									"// Tests",
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has success status', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('success');",
									"});",
									"",
									"pm.test('Response contains token', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('token');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"jean.rakoto@univ.mg\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login?email=jean.rakoto@univ.mg&password=password123",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"auth",
								"login"
							],
							"query": [
								{
									"key": "email",
									"value": "jean.rakoto@univ.mg"
								},
								{
									"key": "password",
									"value": "password123"
								}
							]
						},
						"description": "Authentification de l'étudiant Jean Rakoto (parcours Développeur)"
					},
					"response": []
				},
