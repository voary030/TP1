{
	"info": {
		"name": "Notes API - Tests Complets avec Vues",
		"description": "Collection complète pour tester l'API des notes avec authentification admin/étudiant et vues SQL",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "studentToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "adminToken",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. AUTHENTIFICATION",
			"item": [
				{
					"name": "Login Étudiant - Jean",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('studentToken', jsonData.data.token);",
									"    console.log('Token étudiant sauvegardé:', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"jean.dupont@univ.mg\",\n    \"password\": \"jeanpass\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "login"]
						}
					},
					"response": []
				},
				{
					"name": "Login Admin",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set('adminToken', jsonData.data.token);",
									"    console.log('Token admin sauvegardé:', jsonData.data.token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"admin@univ.mg\",\n    \"mot_de_passe\": \"adminpass\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/auth/admin/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "auth", "admin", "login"]
						}
					},
					"response": []
				}
			]
		},
